<Window x:Class="MetaLol.Desktop.ChampionDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:MetaLol.Desktop"
        local:DesktopWindowBehavior.Enabled="True"
        Title="Detalle de recomendación" Width="1040" Height="720" MinWidth="720" MinHeight="500"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid Margin="22,0,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="PICK ANALYSIS // LOADOUT" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" />
            <TextBlock Text="OBJETOS + RUNAS" Foreground="{StaticResource TextMuted}" FontFamily="Consolas"
                       FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button Content="×" Style="{StaticResource WindowButton}" HorizontalAlignment="Right" FontSize="20"
                    Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
            <StackPanel>
                <Border Style="{StaticResource PanelCard}" Padding="16" Margin="0,8,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="58" Height="58" CornerRadius="9" BorderBrush="{StaticResource Accent}" BorderThickness="1">
                            <Image x:Name="ChampionImage" Stretch="UniformToFill" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ChampionName" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock x:Name="ChampionTitle" Foreground="{StaticResource TextMuted}" FontSize="11"
                                           Margin="10,7,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="RecommendationReason" Foreground="#B8C7D9" TextWrapping="Wrap"
                                       FontSize="11" LineHeight="16" Margin="0,6,20,0" />
                        </StackPanel>

                        <Border Grid.Column="2" Background="#122D3D" BorderBrush="#2E6074" BorderThickness="1"
                                CornerRadius="9" Padding="16,8" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="SCORE" Style="{StaticResource EyebrowText}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="ScoreText" Foreground="{StaticResource Accent}" FontFamily="Consolas"
                                           FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock x:Name="StatText" Foreground="{StaticResource TextMuted}" FontFamily="Consolas"
                                           FontSize="9" HorizontalAlignment="Center" MaxWidth="290" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource PanelCard}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="ADAPTIVE BUILD" Style="{StaticResource EyebrowText}" />
                                    <TextBlock Text="Objetos sugeridos" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,10" />
                                </StackPanel>
                                <TextBlock Text="ORDEN RECOMENDADO →" Foreground="#607E98" FontFamily="Consolas"
                                           FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                            </Grid>

                            <ItemsControl x:Name="ItemsList" Grid.Row="1">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="92" Background="#101D2F" BorderBrush="#24425D" BorderThickness="1"
                                                CornerRadius="8" Padding="8" Margin="0,0,7,7" ToolTip="{Binding Description}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Image Source="{Binding ImageUrl}" Width="42" Height="42" HorizontalAlignment="Left" />
                                                <TextBlock Grid.Row="1" Text="{Binding Name}" TextWrapping="Wrap" FontSize="10"
                                                           LineHeight="13" Margin="0,5,0,0" VerticalAlignment="Top" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Grid.Row="2" Background="#0B1726" BorderBrush="#1D3952" BorderThickness="1"
                                    CornerRadius="7" Padding="10,8" Margin="0,5,7,0">
                                <TextBlock x:Name="BuildNote" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                           FontSize="10" LineHeight="15" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="16">
                        <StackPanel x:Name="RunePagePanel">
                            <TextBlock Text="RUNE PAGE // ORDEN EXACTO" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="Configura primero el árbol primario y después el secundario."
                                       Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,3,0,10" />

                            <Border Background="#0D1929" BorderBrush="{Binding Primary.Accent}" BorderThickness="1"
                                    CornerRadius="8" Padding="10" Margin="0,0,0,9">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Primary.ImageUrl}" Width="30" Height="30" />
                                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="1 · ÁRBOL PRIMARIO" FontFamily="Consolas" FontSize="9"
                                                           Foreground="{Binding Primary.Accent}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Primary.Name}" FontSize="14" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Primary.ColorName, StringFormat={} · {0}}"
                                                               Foreground="{Binding Primary.Accent}" FontFamily="Consolas"
                                                               FontSize="9" Margin="6,4,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="ELIGE LAS 4" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{Binding Primary.Accent}" FontFamily="Consolas" FontSize="9" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Primary.Selections}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#111F31" BorderBrush="#24425D" BorderThickness="1"
                                                        CornerRadius="6" Padding="7" Margin="0,0,6,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="38" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="{Binding Rune.ImageUrl}" Width="32" Height="32" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Step}" Foreground="#607E98" FontFamily="Consolas"
                                                                       FontSize="8" />
                                                            <TextBlock Text="{Binding Rune.Name}" FontSize="10" TextWrapping="Wrap"
                                                                       LineHeight="12" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Background="#0D1929" BorderBrush="{Binding Secondary.Accent}" BorderThickness="1"
                                    CornerRadius="8" Padding="10" Margin="0,0,0,9">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Secondary.ImageUrl}" Width="27" Height="27" />
                                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="2 · ÁRBOL SECUNDARIO" FontFamily="Consolas" FontSize="9"
                                                           Foreground="{Binding Secondary.Accent}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Secondary.Name}" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Secondary.ColorName, StringFormat={} · {0}}"
                                                               Foreground="{Binding Secondary.Accent}" FontFamily="Consolas"
                                                               FontSize="9" Margin="6,3,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="ELIGE ESTAS 2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{Binding Secondary.Accent}" FontFamily="Consolas" FontSize="9" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Secondary.Selections}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#111F31" BorderBrush="#24425D" BorderThickness="1"
                                                        CornerRadius="6" Padding="7" Margin="0,0,6,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="38" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="{Binding Rune.ImageUrl}" Width="32" Height="32" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Step}" Foreground="#607E98" FontFamily="Consolas"
                                                                       FontSize="8" />
                                                            <TextBlock Text="{Binding Rune.Name}" FontSize="10" TextWrapping="Wrap"
                                                                       LineHeight="12" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <StackPanel>
                                <TextBlock Text="3 · FRAGMENTOS DE ESTADÍSTICAS" Style="{StaticResource EyebrowText}"
                                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Shards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#101D2F" BorderBrush="#24425D" BorderThickness="1"
                                                    CornerRadius="6" Padding="6" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding ImageUrl}" Width="25" Height="25" />
                                                    <StackPanel Margin="5,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Step}" Foreground="#607E98" FontFamily="Consolas"
                                                                   FontSize="7" />
                                                        <TextBlock Text="{Binding Name}" FontSize="8" TextWrapping="Wrap"
                                                                   LineHeight="10" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
